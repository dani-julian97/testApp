# Supabase (public client keys only — never put the service-role key here)
# For this vanilla PWA, copy js/config/env.local.example.js → js/config/env.local.js
# and fill in the values. Optionally mirror them here for tooling.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Edge Function secrets (set in Supabase Dashboard / CLI — never ship to the client)
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_URL=
